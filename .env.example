# Google OAuth (next-auth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Backend API (Express service in app.js)
NEXT_PUBLIC_API_BASE=http://localhost:8080
PROJECT_ID=

# Shared secret between the Next.js server and the Express backend.
# Must match on both sides. Only the Next.js server (which enforces RBAC)
# should ever send this — never expose it to the browser.
INTERNAL_API_KEY=

# TEMPORARY TESTING ONLY. When "true", the sign-in page shows buttons to
# log in as admin/doctor/patient, bypassing the real role lookup in
# config/roles.ts. Leave unset/false everywhere except while testing —
# set to false (or remove the feature, see lib/devRole.ts) before real
# launch, otherwise anyone can grant themselves admin.
NEXT_PUBLIC_ENABLE_DEV_ROLE_SWITCH=false

# Optional override for the chatbot telemetry fetch only. Leave unset to
# reuse NEXT_PUBLIC_API_BASE (recommended) — the chat route falls back to it.
HOSPITAL_API_URL=
